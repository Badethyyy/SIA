$gatewayUrl = 'http://localhost/payment-gateway/api/payments.php';
$idempotencyKey = 'cart-order-' . $orderId;

$payload = [
    'order_id' => $orderId,
    'amount' => (float) number_format($total, 2, '.', ''),
    'customer_name' => $customer,
    'payment_method' => $method,
    'idempotency_key' => $idempotencyKey,
    'outcome' => 'SUCCESS'
];

$ch = curl_init($gatewayUrl);
curl_setopt_array($ch, [
    CURLOPT_POST => true,
    CURLOPT_POSTFIELDS => json_encode($payload),
    CURLOPT_HTTPHEADER => ['Content-Type: application/json'],
    CURLOPT_RETURNTRANSFER => true,
    CURLOPT_CONNECTTIMEOUT => 5,
    CURLOPT_TIMEOUT => 15
]);

$response = curl_exec($ch);
$curlError = curl_error($ch);
$httpCode = (int) curl_getinfo($ch, CURLINFO_HTTP_CODE);
curl_close($ch);

$title = 'Payment pending';
$message = 'Please check your order status before trying again.';

if ($response === false) {
    $message = 'The payment gateway could not be reached. Your order is saved.';
} else {
    $result = json_decode($response, true);

    if (
        $httpCode >= 200 && $httpCode < 300 &&
        is_array($result) &&
        isset($result['order_id'], $result['status']) &&
        (int) $result['order_id'] === $orderId &&
        in_array($result['status'], ['SUCCESS', 'FAILED', 'PENDING'], true)
    ) {
        $transactionId = $result['transaction_id'] ?? null;

        if ($transactionId !== null && !is_string($transactionId)) {
            $transactionId = null;
        }

        if ($result['status'] === 'SUCCESS' &&
            ($result['success'] ?? false) === true &&
            $transactionId !== null && $transactionId !== '') {
            $newStatus = 'PAID';
            $title = 'Payment successful';
            $message = 'Your payment was successful.';
        } elseif ($result['status'] === 'FAILED') {
            $newStatus = 'PAYMENT_FAILED';
            $title = 'Payment failed';
            $message = 'The payment was not successful.';
        } else {
            $newStatus = 'PENDING_PAYMENT';
            $title = 'Payment pending';
            $message = 'Your payment is still pending. Check your order status.';
        }

        $stmt = $pdo->prepare(
            'UPDATE orders SET status = ?, gateway_transaction_id = ? WHERE id = ?'
        );
        $stmt->execute([$newStatus, $transactionId, $orderId]);
    } else {
        $message = 'The gateway returned an invalid response. Your order is saved for checking.';
    }
}

finish($title, $message);
